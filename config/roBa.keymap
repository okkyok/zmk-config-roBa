#include <dt-bindings/zmk/mouse-gesture.h>

// &zip_temp_layer is used below for &mkp_input_listener. roBa_R.overlay includes
// this too, but the keymap is compiled for both halves, so it needs its own.

#include <input/processors.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_SCRL_VAL 100

// Layer index aliases

#define BASE   0
#define SYMBOL 1
#define NUM    2
#define ARROW  3
#define BT_L   4
#define MOUSE  5
#define SCROLL 6
#define L7     7
#define L8     8
#define L9     9

&mt {
    flavor = "balanced";

    // 起点は1回目の「押下」なので、押している時間も窓に含まれる。&lt と揃えて 300。

    quick-tap-ms = <300>;

    // 直前に別キーを打っていれば即タップに倒す。連続入力中の判定待ちを無くす。
    // 150msでは単語の切れ目など打鍵間隔が開いた場面をすり抜けて誤爆したため170msへ。

    require-prior-idle-ms = <170>;
};

&lt {
    flavor = "balanced";
    quick-tap-ms = <300>;
};

&trackball {
    // Auto mouse layer is now driven by &zip_temp_layer (see roBa_R.overlay).

    scroll-layers = <SCROLL>;
};

// A click is the end of a mouse interaction, so drop AML 300ms after any mouse
// button event. This removes the need to remember to press an exit key before
// typing again. Reuses the single &zip_temp_layer instance with a shorter TTL
// (multiple instances of that processor do not compile - zmk#3282).

&mkp_input_listener { input-processors = <&zip_temp_layer MOUSE 300>; };

/ {
    combos {
        compatible = "zmk,combos";

        tab {
            bindings = <&kp TAB>;
            key-positions = <12 13>;
        };

        shift_tab {
            bindings = <&kp LS(TAB)>;
            key-positions = <11 12>;
        };

        muhennkann {
            bindings = <&to_layer_0 INT_MUHENKAN>;
            key-positions = <11 10>;
        };

        double_quotation {
            bindings = <&kp DOUBLE_QUOTES>;
            key-positions = <20 21>;
        };

        eq {
            bindings = <&kp EQUAL>;
            key-positions = <24 25>;
        };

        // Paste used to sit on I alone, which is a top-frequency romaji key and
        // pasted into the document on every AML misfire. U+I on the MOUSE layer
        // only. Both positions must be in excluded-positions (roBa_R.overlay)
        // or temp_layer drops the layer before the combo is evaluated.

        mouse_paste {
            bindings = <&kp LG(V)>;
            key-positions = <6 7>;
            layers = <MOUSE>;
        };

        // 全角入力中に半角スペースを打つ「zを押しながらスペース」用。
        // Zのhold-tapはロールオーバー対策(require-prior-idle等)がすべて
        // タップに倒す方向のため、素早いz+スペースでは文字zが変換に入って
        // しまう。タイミングでは判別できないが相手キーがスペースであれば
        // 半角スペース意図と確定できるので、コンボでShift+Spaceを
        // アトミックに送出する。IME側のShift+Space=半角スペース設定が前提。
        // timeout-msはshift_pの教訓どおりhm_shift_zのtapping-term(170)と
        // 同値にする。以前の100msでは、Z→Spaceの間隔が100〜200msのとき
        // コンボ切れ+hold未確定(Spaceはhold-trigger-key-positions外なので
        // Z即タップ)の隙間に落ち、「z」が変換に入っていた。
        // (check_keymap_gaps.pyが検出した隙間)
        // slow-release+専用マクロでZを離すまでShiftを維持する
        // (理由は half_space_hold マクロ定義のコメント参照)。

        half_space {
            bindings = <&half_space_hold>;
            key-positions = <22 38>;
            timeout-ms = <170>;
            slow-release;
            layers = <BASE>;
        };

        // Z(Shift)+P の大文字Pを、同時押しを検出した瞬間に確定させる。
        // hm_shift_z のbalanced判定は「相手キーを押して離す」までhold確定を
        // 待つため、素早くロールして先にZを離すと「zp」に化ける。flavorを
        // hold-preferredにするとリスト内の全キーが押下即Shiftになり副作用が
        // 大きいので、Pだけコンボでアトミックに送出する。ローマ字に「zp」は
        // 現れないため誤爆の余地がない。
        // timeout-msは必ずtapping-term-ms(170)と同値にすること: 100msだと
        // Z→Pの間隔が100〜170msのときコンボ切れ+hold未確定の隙間が生まれ、
        // Pより先にZを離すと「zp」に化ける(実際に発生した)。170msなら
        // 間隔0〜170msはコンボ、170ms超はhold確定済みのShiftで隙間がない。
        // slow-release+専用マクロでZを離すまでShiftを維持する
        // (理由は shift_enter_hold マクロ定義のコメント参照)。

        shift_p {
            bindings = <&shift_p_hold>;
            key-positions = <22 9>;
            timeout-ms = <170>;
            slow-release;
            layers = <BASE>;
        };

        // Enter(SYMBOL)+P の「@」を、同時押しを検出した瞬間に確定させる。
        // &lt のbalanced判定は「Pを押して離す」までhold確定を待つため、
        // チョン押しでPより先にEnterを離すとタップに倒れ「Enter+p」に化ける。
        // さらに&ltのquick-tap-ms=300により、Enter(確定/改行)直後300ms以内の
        // 押し直しは必ずタップ(リピート)になりSYMBOLに入れない隙もある。
        // half_space(Z+Space)と同じく相手キーがPなら@意図と確定できるので
        // コンボでアトミックに送出する。コンボはhold-tapより先に評価される
        // ためquick-tapの影響も受けない。
        // timeout-msはshift_pの教訓どおり&ltのtapping-term(200)と同値にして
        // コンボ切れ+hold未確定の隙間を作らない。
        // 注意: 直接入力で「p→Enter」を200ms以内に重ねてロールすると@に
        // 化け得る(ローマ字はpで終わる打鍵列がないため日本語入力は安全)。

        at_mark {
            bindings = <&kp AT_SIGN>;
            key-positions = <41 9>;
            timeout-ms = <200>;
            layers = <BASE>;
        };

        // Z(Shift)+Enter の「Shift+Enter」を、同時押しを検出した瞬間に確定
        // させる。shift_pと同型の隙間: hm_shift_z のbalanced判定は「相手キー
        // を押して離す」までhold確定を待つため、素早くロールして先にZを離すと
        // 「z」+Enter(通常の改行)に化ける。hold-trigger-key-positionsに41
        // (Enter)を加えただけではこの「Zを先に離す」ケースは救えない
        // (balanced判定に入るだけで、判定順序の問題はそのまま残るため)。
        // H/K/L と違い、zの後にEnterが続く入力をローマ字で使う理由がなく、
        // 「先にZを離す」を逃げ道として残す必要もないため、Pと同じく
        // コンボでアトミックに送出する。
        // timeout-msはshift_p/at_markと同じくtapping-term-ms(170)と同値にして
        // コンボ切れ+hold未確定の隙間を作らない。
        // さらに slow-release+専用マクロで「Zを離すまでShift維持」にする。
        // &kp LS(ENTER) の直バインドでは相手キー(Enter)を離した瞬間にコンボが
        // バインディングを解放してShiftが消え、Zを押したままEnterを連打すると
        // 2回目以降がただの改行に化けていた(実バグ。詳細はマクロ定義参照)。

        shift_enter {
            bindings = <&shift_enter_hold>;
            key-positions = <22 41>;
            timeout-ms = <170>;
            slow-release;
            layers = <BASE>;
        };

        // F+G同時押し = F17。Raycast側のホットキーをF17に設定して使う。
        // 以前はA(Ctrl)+GのCtrl+Gで起動していたが、a→gは「あが/あご」等で
        // ローマ字に実在するため、ホールドタップ調整でもコンボでも
        // 「タイピング保護」と「即時起動」を両立できなかった(CLAUDE.md参照)。
        // F+Gは修飾キーを介さず専用キーF17を送るのでホールドタップとの
        // 奪い合い(隙間)が構造的に発生せず、「fg」はローマ字にも英語にも
        // 実在しない並びなので誤発もない。FとGは隣接キーなので人差し指
        // 1本を寝かせた同時押しで発火する。
        // timeout-msは200に拡張(既定50msだと「少し長めに押す」呼び出し方に
        // 対して切れが早すぎ、コンボ不成立でF/Gそれぞれの&mt(Alt/Ctrl)へ
        // 流れてしまっていた)。fgはローマ字にも英語にも現れないため、
        // 広げてもタイピング中の誤発リスクは生じない(raycast_agのa→gとは
        // 異なりrequire-prior-idleでの抑止は不要)。
        // 不発時は「fg」の文字入力に倒れるだけで無害。

        raycast_fg {
            bindings = <&kp F17>;
            key-positions = <13 14>;
            timeout-ms = <200>;
            layers = <BASE>;
        };

        // O+P は「ぽ」等の高頻度ロールオーバーで誤爆する(U+Iのpasteコンボと
        // 同じ問題)。require-prior-idle-ms で文中のpoは抑止しつつ、
        // 打ち始め(アイドル後)にコンボへ食われた場合も実害が出ないよう、
        // ht_gesture_l8 でタップ=「po」打鍵 / ホールド=L8 に振り分ける。
        // ジェスチャー時はどうせストローク中押しっぱなしなのでホールドに
        // 自然に倒れる。K+Lは "kl" がローマ字に現れないため従来のまま。

        gesture_l8 {
            bindings = <&ht_gesture_l8 L8 0>;
            key-positions = <8 9>;
            require-prior-idle-ms = <150>;
        };

        gesture_l9 {
            bindings = <&mo L9>;
            key-positions = <19 20>;
            require-prior-idle-ms = <150>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };

        // NOTE: 動画版の mul_mark / div_mark の実際の出力が不明のため、
        // テンキーの × (KP_MULTIPLY) / ÷ (KP_DIVIDE) を暫定割当。

        mul_mark: mul_mark {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp KP_MULTIPLY>;
            label = "MUL_MARK";
        };

        div_mark: div_mark {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp KP_DIVIDE>;
            label = "DIV_MARK";
        };

        // Z系加速コンボ(half_space/shift_p/shift_enter)の受け先マクロ群。
        // &kp LS(X) を直接バインドすると、コンボは「最初のキーが離れた時点」で
        // バインディング全体を解放するため、相手キー(X)を離した瞬間にShiftも
        // 消える。Zは物理的に押しっぱなしでも、押下イベント自体がコンボに
        // 消費済みで hm_shift_z は働いておらず、そのまま相手キーを連打すると
        // 2回目以降が無修飾に化ける(Z+Enter連打で2回目がただの改行になる
        // 実バグ)。
        // 対策: コンボ側に slow-release(全キー解放までバインディング維持)を
        // 付け、マクロで「Shift押下→相手キーを1回タップ→(解放まで保持)→
        // Shift解放」とする。Zを押している限りShiftが維持されるので、
        // 相手キーの連打も後続キーの大文字入力もhold確定後と同じ挙動になる。
        // &kp LS(X) + slow-release だけだと相手キーのキーコードが押しっぱなし
        // になりOSのオートリピートが暴発するため、タップとShift保持を
        // マクロで分離している。

        shift_enter_hold: shift_enter_hold {
            compatible = "zmk,behavior-macro";
            wait-ms = <0>;
            tap-ms = <0>;
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LSHFT>,
                <&macro_tap>,
                <&kp ENTER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp LSHFT>;

            label = "SHIFT_ENTER_HOLD";
        };

        shift_p_hold: shift_p_hold {
            compatible = "zmk,behavior-macro";
            wait-ms = <0>;
            tap-ms = <0>;
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LSHFT>,
                <&macro_tap>,
                <&kp P>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp LSHFT>;

            label = "SHIFT_P_HOLD";
        };

        half_space_hold: half_space_hold {
            compatible = "zmk,behavior-macro";
            wait-ms = <0>;
            tap-ms = <0>;
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LSHFT>,
                <&macro_tap>,
                <&kp SPACE>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp LSHFT>;

            label = "HALF_SPACE_HOLD";
        };

        // O+Pコンボがタイピングの打ち始めで誤発火した際のタップ救済:
        // 食われた2打鍵の代わりに「p→o」を打鍵し直す。hold-tapのタップ側は
        // 1パラメータ必須のためone-param形式だが、パラメータは使用しない
        // (ht_gesture_l8からダミーの0が渡される)。

        type_po: type_po {
            compatible = "zmk,behavior-macro-one-param";
            wait-ms = <0>;
            tap-ms = <0>;
            #binding-cells = <1>;
            bindings = <&kp P &kp O>;
            label = "TYPE_PO";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        scroll_up_down: scroll_up_down {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

            tap-ms = <20>;
        };

        scroll_right_left: scroll_right_left {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;

            tap-ms = <20>;
        };

        // Aは最高頻度キー。以前は balanced + require-prior-idle-ms=170 で連続
        // 入力中のhold誤爆を防いでいたが、prior-idleは「直前打鍵から170ms以内の
        // A押下」を押した瞬間にタップ確定させるため、タイピング中にミスへ気づいて
        // 即 A長押し+H(Ctrl+H)で消す操作が「(a)h」の文字入力に化けていた。
        // prior-idleをやめ、代わりに2段構えでロールオーバーを守る:
        //  - hold-trigger-key-positions=<17 19 20>(H/K/L): タイピング中に多用する
        //    Ctrl+H(1文字削除)・Ctrl+K(カタカナ変換)・Ctrl+L(英数変換)だけhold候補
        //    に残し、それ以外のキーが割り込んだら即タップ確定。保護範囲は従来同等
        //    で、判定時点がA押下時→相手キー押下時になるだけ(aの文字は次キーと
        //    同時に出る)。一時期Raycast(Ctrl+G)用にGもリストに入れていたが、
        //    a→g(あが/あげ)のロール保護と両立できず誤爆を繰り返したため、
        //    Raycastはraycast_fgコンボ(F+G→F17)へ移設してGを外した。
        //    Gはリスト外=A押下の瞬間タップ確定に戻り、タイミング非依存で安全。
        //  - tap-preferred: H/K/Lとの組でも200ms以内にAを離せばタップ。「あは/
        //    あか/あき/〜aは」等のa→h,k,l巻き込みでCtrl+H(=無言の1文字削除)や
        //    Ctrl+K(=意図しないカタカナ変換)が誤発しない。
        // tapping-termは200を維持する。一度150へ縮めたところ、通常タイピングの
        // a単打の押下時間(押して離すまで)は150msを超えることが多く、a単打が
        // hold(Ctrl)扱いになり「aが出ない」回帰を起こした(CLAUDE.md参照)。
        // Ctrl+H/K/LはAをterm以上押し続けたときだけ発動し、term前に押した
        // 相手キーもキュー再生されるので取りこぼさない。リスト外キーとの
        // Ctrl組み合わせはAを長押ししてhold確定後に相手キーを押せば従来
        // どおり。quick-tap-msはタップ直後の押し直しをCtrlとして使うため0のまま。

        hm_instant: hm_instant {
            compatible = "zmk,behavior-hold-tap";
            label = "HM_INSTANT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            quick-tap-ms = <0>;
            hold-trigger-key-positions = <17 19 20>;
        };

        // S(Shift+Cmd)は「し(shi)」「しゃ(sha)」等のs→hロールで、hを押して
        // 離した時点でbalancedがholdを確定し、後続もろともShift+Cmd+H/Iに
        // 化ける誤爆があった(require-prior-idle=170は連続入力中しか効かず、
        // 打ち始めや打鍵間隔の開いた「し」がすり抜ける)。
        // タイピング快適性を最優先し、tap-preferredの専用behaviorへ差し替え:
        //  - キー割り込みではholdに倒さない。termの200ms未満でSを離せば常に
        //    タップで、巻き込んだキーもキュー再生されるので取りこぼしなし
        //  - require-prior-idle=170は維持: 連続入力中は押した瞬間タップ確定で
        //    表示遅延もゼロ(アイドル後の打ち始めのみキュー再生の僅かな遅延)
        //  - Shift+Cmdショートカットは、Sを200ms(tapping-term)押し込んで
        //    hold確定させてから相手キーを押す(termまでに巻き込んだ相手キーも
        //    mods付きで再生される)。トレードオフ: 打鍵直後170ms以内に
        //    S長押しを始めるショートカットは効かない(一拍おいてから押す)
        // quick-tap=300はタップ直後の押し直しを必ずタップに倒す(&mtと同値)。
        // D(Cmd)/F(Alt)/G(Ctrl)にも同型の誤爆リスクはあるが、実害報告のある
        // Sのみ差し替え、他は顕在化したら同じbehaviorへ寄せる。

        hm_typing: hm_typing {
            compatible = "zmk,behavior-hold-tap";
            label = "HM_TYPING";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            quick-tap-ms = <300>;
            require-prior-idle-ms = <170>;
        };

        // &lt と同じ設定に require-prior-idle-ms を追加した layer-tap。
        // Pキー(SCROLL)はロールオーバーの多い「ぽ/ぴ」等の直後に叩かれるため、
        // &mt と同様に直前打鍵から150ms以内なら即タップに倒す。
        // 他の &lt 利用箇所(SPACEやENTER等)は単語直後にあえて長押しする
        // 使い方があるため、影響をPキーだけに限定する。
        // flavorはtap-preferredにすること: balancedだと打ち始め(アイドル後)の
        // 速い「pu」等でP押下中にUの押下→解放が完了した時点でholdが確定し、
        // pが消えて「u」だけになる誤爆があった。SCROLLホールドはトラック
        // ボール操作専用で他キーとの同時押しを必要としないため、キー割り込み
        // でholdに倒す理由がなく、200ms押し続けたときだけholdで十分。

        lt_instant_tap: lt_instant_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "LT_INSTANT_TAP";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            quick-tap-ms = <300>;
            require-prior-idle-ms = <150>;
        };

        // Z(Shift)+/ の「？」がタイプ中に「・」へ化ける誤爆対策。
        // 原因: &mt の require-prior-idle-ms=170 は「直前打鍵から170ms以内の
        // Z押下」をどれだけ長押ししても押した瞬間にタップ(z)確定させるため、
        // 文末を速く打った直後の Z+/ が「z」「/」となり、IMEの「z/」→「・」
        // 変換に食われる(zは変換で消費されるので画面には・だけが残る)。
        // 対策: Z専用hold-tapで prior-idle をやめ、代わりに
        // hold-trigger-key-positionsで「ローマ字でzの直後に来ないキー」を
        // 列挙して保護する:
        //  - リスト外のキー(zに続く母音 A/I/U/E/O と拗音のY)が割り込んだら
        //    即タップ(z)。prior-idleと違いタイミング非依存なので「ず(zu)」等の
        //    速い巻き込みでも誤holdしない。
        //  - リスト内のキーが割り込んだ時だけbalanced判定: Zを押したまま相手
        //    キーを押して離せばhold(Shift)。z→相手キーを文字として速くロール
        //    した場合(先にzを離す)はタップのまま。
        //    balancedは「相手キーを押して離す」までhold確定を待つため、素早い
        //    ロールで先にZを離すと「zp」に化ける。ここをflavorで解決すると
        //    (hold-preferred)リスト内の全キーが押下即Shiftになり副作用が
        //    大きいので、大文字化の頻度が高いPだけshift_pコンボで即時化する。
        // リストは / と Enter に加え、母音とY以外の全英字。これで
        //  - Z+/ = 「？」
        //  - Z長押し+英字 = 大文字(Z+Pが「zp」に化けていた誤爆への対策)
        //  - Z長押し+K等がIMEのzショートカット(zk=↑/zh=←/zj=↓/zl=→)に
        //    食われて矢印に化ける誤爆の防止
        // をまとめて実現できる。↑や・を出したい時は従来どおりzを離してから
        // 相手キーを打つ。大文字の A/I/U/E/O/Y だけはZシフトでは打てない
        // (即タップ確定のため)ので、X側Shiftか右手の/(Shift)を使う。
        // Enter(41)も同構造でShift+Enter(改行/変換確定)が効かず「z」+改行に
        // なっていた。ローマ字ではzの後に必ず母音が要るため「z直後にEnter」は
        // 日本語入力で意図されることがなく、balanced判定に入れて安全。ただし
        // Pと同じく、hold-trigger-key-positionsへの追加だけでは「先にZを離す」
        // 高速ロールを救えない(balanced判定に入っても判定順序の問題は残る)ため、
        // Pと同じくshift_enterコンボ(combos参照)を併設して即時確定させる。
        // 「・」自体は従来どおり / 単打で入力できるので失うものはない。
        // Z+Spaceのhalf_spaceコンボと同じ「相手キーで意図を確定する」発想だが、
        // シフトとしてZを先に押し込んでから/を押すとコンボのtimeout-msを超えて
        // 取りこぼすため、基本はhold-tap側で実装する。P/Enterのみ即時性を優先
        // してそれぞれ専用コンボ(timeout=tapping-termの170ms)を併設し、170ms超の
        // 「Zを先に押し込む」使い方はhold確定済みのShiftが受け持つ。

        hm_shift_z: hm_shift_z {
            compatible = "zmk,behavior-hold-tap";
            label = "HM_SHIFT_Z";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;

            // 200ms→170msに短縮。Z+相手キーを両方押しっぱなしにする使い方
            // (balancedなので相手キー解放 or このタイマー切れで確定)での
            // Shift確定の体感遅延を縮める。150ms以下には縮めない
            // (通常タイピングの単打がhold化けする回帰。CLAUDE.md参照)。

            tapping-term-ms = <170>;
            flavor = "balanced";
            quick-tap-ms = <300>;
            hold-trigger-key-positions = <0 1 3 4 9 11 12 13 14 17 18 19 20 23 24 25 26 29 30 33 41>;
        };

        // NUM(スペース)長押し+Aが「1」でなく「スペース+a」になる誤爆対策。
        // 原因は &lt の quick-tap-ms=300: スペースをタップした後300ms以内に
        // 同キーを押し直すと、どれだけ長押ししてもタップ(スペース押しっぱなし)
        // 確定となり、NUMレイヤーに入らないままAが「a」で出る。
        // 「変換/スペース→すぐ数字入力」の速い流れでちょうど踏む。
        // 折衷案としてquick-tap-msを300→150に短縮(0にはしない)。
        // スペースのオートリピート連打(タップ直後に押し直して長押し)は
        // 150ms以内の速い押し直しに限り従来どおり有効なまま、
        // 「変換確定→数字」のようなやや間の空く(150ms超の)押し直しでは
        // 長押しがNUMとして正しく確定するようにする。0にする案より
        // 誤爆の再発余地はわずかに残るが、スペース連打の使い勝手を残す。
        // Enter(SYMBOL)等の他の &lt には手を付けず影響をスペースに限定する。

        lt_num_space: lt_num_space {
            compatible = "zmk,behavior-hold-tap";
            label = "LT_NUM_SPACE";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "balanced";
            quick-tap-ms = <150>;
        };

        // O+Pコンボ(gesture_l8)の受け先。短く押して離せばタップ=type_po
        // (「po」と打鍵し直す)、押し続ければホールド=L8ジェスチャー層。
        // flavorは必ずtap-preferredにすること: balancedやhold-preferredだと
        // 「ポイント」のような速い後続打鍵(i等)が割り込み判定でholdを確定
        // させ、poが消えて後続キーもL8(不活性)に食われる。

        ht_gesture_l8: ht_gesture_l8 {
            compatible = "zmk,behavior-hold-tap";
            label = "HT_GESTURE_L8";
            bindings = <&mo>, <&type_po>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
        };

        // BT_L層でA(=LCTRL)を押している間だけ S→Q / D→W に化けるmod-morph。
        // keep-modsでCtrlを保持したまま送るので、OSには Ctrl+Q / Ctrl+W が
        // 届く(左手だけで完結するショートカット用)。Ctrl非押下時は
        // BT_L層の従来割り当て(S=LGUI, D=Shift+Tab)のまま。

        mm_bt_s_q: mm_bt_s_q {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_BT_S_Q";
            #binding-cells = <0>;
            bindings = <&kp LGUI>, <&kp Q>;

            mods = <(MOD_LCTL)>;
            keep-mods = <(MOD_LCTL)>;
        };

        mm_bt_d_w: mm_bt_d_w {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_BT_D_W";
            #binding-cells = <0>;
            bindings = <&kp LS(TAB)>, <&kp W>;

            mods = <(MOD_LCTL)>;
            keep-mods = <(MOD_LCTL)>;
        };
    };

    zip_mouse_gesture_l7: zip_mouse_gesture_l7 {
        compatible = "zmk,input-processor-mouse-gesture";
        #input-processor-cells = <0>;
        always-active;
        enable-eager-mode;
        suppress-movement;
        stroke-size = <5>;
        movement-threshold = <6>;
        idle-timeout-ms = <100>;
        gesture-cooldown-ms = <120>;

        // Tab management

        prev_tab {
            pattern = <GESTURE_LEFT>;
            bindings = <&kp LC(LS(TAB))>;
        };

        next_tab {
            pattern = <GESTURE_RIGHT>;
            bindings = <&kp LC(TAB)>;
        };

        new_tab {
            pattern = <GESTURE_UP>;
            bindings = <&kp LG(T)>;
        };

        close_tab {
            pattern = <GESTURE_DOWN>;
            bindings = <&kp LG(W)>;
        };
    };

    zip_mouse_gesture_l8: zip_mouse_gesture_l8 {
        compatible = "zmk,input-processor-mouse-gesture";
        #input-processor-cells = <0>;
        always-active;
        enable-eager-mode;
        suppress-movement;
        stroke-size = <5>;
        movement-threshold = <6>;
        idle-timeout-ms = <100>;
        gesture-cooldown-ms = <120>;

        // Virtual desktop (Mission Control space) management
        // Left/right reversed to mimic trackpad-style natural swipe direction.

        desk_prev {
            pattern = <GESTURE_RIGHT>;
            bindings = <&kp LC(LEFT_ARROW)>;
        };

        desk_next {
            pattern = <GESTURE_LEFT>;
            bindings = <&kp LC(RIGHT_ARROW)>;
        };

        mission_ctrl {
            pattern = <GESTURE_UP>;
            bindings = <&kp LC(UP_ARROW)>;
        };

        app_expose {
            pattern = <GESTURE_DOWN>;
            bindings = <&kp LC(DOWN_ARROW)>;
        };
    };

    zip_mouse_gesture_l9: zip_mouse_gesture_l9 {
        compatible = "zmk,input-processor-mouse-gesture";
        #input-processor-cells = <0>;
        always-active;
        enable-eager-mode;
        suppress-movement;
        stroke-size = <5>;
        movement-threshold = <6>;
        idle-timeout-ms = <100>;
        gesture-cooldown-ms = <120>;

        // App switching / quick actions

        prev_app {
            pattern = <GESTURE_LEFT>;
            bindings = <&kp LG(LS(TAB))>;
        };

        next_app {
            pattern = <GESTURE_RIGHT>;
            bindings = <&kp LG(TAB)>;
        };

        focus_url {
            pattern = <GESTURE_UP>;
            bindings = <&kp LG(L)>;
        };

        spotlight {
            pattern = <GESTURE_DOWN>;
            bindings = <&kp LG(SPACE)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q                     &kp W                          &kp E       &kp R           &kp T                                                                                    &kp Y             &kp U       &kp I       &kp O           &lt_instant_tap SCROLL P
&hm_instant LCTRL A       &hm_typing LS(LEFT_COMMAND) S  &mt LGUI D  &mt LALT F      &mt LCTRL G              &kp TAB                         &mt RC(RS(RA(RGUI))) SEMICOLON  &kp H             &mt RALT J  &mt RGUI K  &mt RS(RGUI) L  &mt RCTRL MINUS
&hm_shift_z LEFT_SHIFT Z  &mt LEFT_SHIFT X               &kp C       &kp V           &kp B                    &lt MOUSE LS(TAB)               &kp RS(RA(RC(RGUI)))            &kp N             &kp M       &kp COMMA   &kp DOT         &mt LEFT_SHIFT SLASH
&kp LGUI                  &kp LALT                       &kp LGUI    &lt BT_L LANG2  &lt_num_space NUM SPACE  &lt_to_layer_0 ARROW LANG1      &kp BACKSPACE                   &lt SYMBOL ENTER                                          &lt MOUSE ESC
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        symbol_layer {
            bindings = <
&kp EQUAL       &kp SLASH  &kp ASTERISK  &kp MINUS  &kp PLUS                          &kp AMPERSAND   &kp CARET        &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp AT_SIGN
&mt LCTRL EXCL  &kp DQT    &kp HASH      &kp DLLR   &kp PRCNT  &trans      &kp COLON  &kp LEFT_BRACE  &kp RIGHT_BRACE  &kp LPAR          &kp RPAR           &kp TILDE
&mt LSHFT F1    &kp F2     &kp F3        &kp F4     &kp F5     &trans      &trans     &kp F6          &kp F7           &kp F8            &kp F9             &mt RSHIFT F10
&trans          &trans     &trans        &trans     &trans     &trans      &trans     &trans                                                                &trans
            >;

            sensor-bindings = <&scroll_right_left>;
        };

        num_layer {
            bindings = <
&kp EQUAL           &kp SLASH     &kp STAR      &kp MINUS     &kp PLUS                                      &kp INT_YEN   &kp DOLLAR    &kp PIPE      &kp COLON              &kp PERCENT
&mt LCTRL NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp NUMBER_5  &trans               &mul_mark  &kp NUMBER_6  &kp NUMBER_7  &kp NUMBER_8  &mt RS(RGUI) NUMBER_9  &mt RCTRL NUMBER_0
&mt LSHFT NUMBER_6  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp NUMBER_0  &kp KP_MULTIPLY      &div_mark  &kp F11       &kp F12       &kp COMMA     &kp DOT                &mt RSHIFT DOLLAR
&trans              &trans        &trans        &trans        &trans        &trans               &trans     &trans                                                           &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        arrow_layer {
            // 右手側はWindows用ショートカット(Win+矢印スナップ, PrintScreen系)。Mac利用時は要調整。

            bindings = <
&kp PG_UP  &trans          &kp UP_ARROW    &trans           &kp PG_DN                                 &kp PG_UP  &kp Y           &kp UP_ARROW    &kp U            &kp PG_DN
&kp HOME   &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp END    &kp LA(LCTRL)      &trans      &kp HOME   &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp END
&kp LSHFT  &trans          &trans          &trans           &kp LSHFT  &kp LGUI           &kp RGUI    &kp RSHFT  &kp H           &trans          &kp J            &kp RSHIFT
&trans     &trans          &trans          &trans           &trans     &trans             &kp DELETE  &trans                                                      &trans
            >;

            sensor-bindings = <&inc_dec_kp LC(TAB) LC(LS(TAB))>;
        };

        bt_layer {
            bindings = <
&trans     &trans      &trans      &trans   &trans                           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&kp LCTRL  &mm_bt_s_q  &mm_bt_d_w  &kp TAB  &trans  &trans      &trans       &trans        &kp LS(TAB)   &trans        &kp TAB       &trans
&trans     &trans      &trans      &trans   &trans  &trans      &bootloader  &trans        &trans        &trans        &trans        &bt BT_CLR
&trans     &trans      &trans      &trans   &trans  &trans      &trans       &kp LGUI                                                &bt BT_CLR_ALL
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        mouse_layer {
            // Y: AMLからの明示的な脱出キー。&trans+non-excludedのままでも
            // いずれ抜けはするが、&to 0でBASEまで即時・確実に戻す。
            // "y"は出力しない(脱出専用、muhennkannコンボのto_layer_0とは異なりキー出力なし)。

            bindings = <
&trans  &trans  &trans  &trans  &trans                      &to 0   &trans    &trans    &kp LG(C)  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &mkp MB1  &mkp MB3  &mkp MB2   &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &mkp MB4  &trans    &mkp MB5   &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                 &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        scroll_layer {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        Gesture_L7 {
            // Trackball gestures only; keys stay inert. See zip_mouse_gesture_l7.

            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        Gesture_L8 {
            // Trackball gestures only; keys stay inert. See zip_mouse_gesture_l8.

            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        Gesture_L9 {
            // Trackball gestures only; keys stay inert. See zip_mouse_gesture_l9.

            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };
    };
};
