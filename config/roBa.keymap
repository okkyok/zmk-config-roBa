#include <dt-bindings/zmk/mouse-gesture.h>

// &zip_temp_layer is used below for &mkp_input_listener. roBa_R.overlay includes
// this too, but the keymap is compiled for both halves, so it needs its own.

#include <input/processors.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_SCRL_VAL 100

// Layer index aliases

#define BASE   0
#define SYMBOL 1
#define NUM    2
#define ARROW  3
#define BT_L   4
#define MOUSE  5
#define SCROLL 6
#define L7     7
#define L8     8
#define L9     9

&mt {
    flavor = "balanced";

    // 起点は1回目の「押下」なので、押している時間も窓に含まれる。&lt と揃えて 300。

    quick-tap-ms = <300>;

    // 直前に別キーを打っていれば即タップに倒す。連続入力中の判定待ちを無くす。

    require-prior-idle-ms = <150>;
};

&lt {
    flavor = "balanced";
    quick-tap-ms = <300>;
};

&trackball {
    // Auto mouse layer is now driven by &zip_temp_layer (see roBa_R.overlay).

    scroll-layers = <SCROLL>;
};

// A click is the end of a mouse interaction, so drop AML 300ms after any mouse
// button event. This removes the need to remember to press an exit key before
// typing again. Reuses the single &zip_temp_layer instance with a shorter TTL
// (multiple instances of that processor do not compile - zmk#3282).

&mkp_input_listener { input-processors = <&zip_temp_layer MOUSE 300>; };

/ {
    combos {
        compatible = "zmk,combos";

        tab {
            bindings = <&kp TAB>;
            key-positions = <11 12>;
        };

        shift_tab {
            bindings = <&kp LS(TAB)>;
            key-positions = <12 13>;
        };

        muhennkann {
            bindings = <&to_layer_0 INT_MUHENKAN>;
            key-positions = <11 10>;
        };

        double_quotation {
            bindings = <&kp DOUBLE_QUOTES>;
            key-positions = <20 21>;
        };

        eq {
            bindings = <&kp EQUAL>;
            key-positions = <24 25>;
        };

        // Paste used to sit on I alone, which is a top-frequency romaji key and
        // pasted into the document on every AML misfire. U+I on the MOUSE layer
        // only. Both positions must be in excluded-positions (roBa_R.overlay)
        // or temp_layer drops the layer before the combo is evaluated.

        mouse_paste {
            bindings = <&kp LG(V)>;
            key-positions = <6 7>;
            layers = <MOUSE>;
        };

        // O+P は「ぽ」等の高頻度ロールオーバーで誤爆する(U+Iのpasteコンボと
        // 同じ問題)。mouse_pasteと同様にMOUSE層のみに限定する。
        // K+Lも同じ理由で限定。

        gesture_l8 {
            bindings = <&mo L8>;
            key-positions = <8 9>;
            layers = <MOUSE>;
        };

        gesture_l9 {
            bindings = <&mo L9>;
            key-positions = <19 20>;
            layers = <MOUSE>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };

        // NOTE: 動画版の mul_mark / div_mark の実際の出力が不明のため、
        // テンキーの × (KP_MULTIPLY) / ÷ (KP_DIVIDE) を暫定割当。

        mul_mark: mul_mark {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp KP_MULTIPLY>;
            label = "MUL_MARK";
        };

        div_mark: div_mark {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp KP_DIVIDE>;
            label = "DIV_MARK";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        scroll_up_down: scroll_up_down {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

            tap-ms = <20>;
        };

        scroll_right_left: scroll_right_left {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;

            tap-ms = <20>;
        };

        // Aは最高頻度キーのため、左手内だけで完結する通常のロールオーバー
        // 打鍵(a+s 等)がそのままholdに誤判定されないようにする。
        // require-prior-idle-msは他の&mt(150ms)より短い80msに留め、直後の
        // Ctrl+A系コンボの反応性を優先しつつ、hold-trigger-key-positionsで
        // 右手側キーのみをhold判定のトリガーに限定することで、左手だけの
        // ロールオーバーはtapping-term-ms経過まで待つ(誤爆しにくい)。

        hm_instant: hm_instant {
            compatible = "zmk,behavior-hold-tap";
            label = "HM_INSTANT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "balanced";
            quick-tap-ms = <0>;
            require-prior-idle-ms = <80>;
            hold-trigger-key-positions = <5 6 7 8 9 16 17 18 19 20 21 28 29 30 31 32 33 40 41 42>;
        };

        // &lt と同じ設定に require-prior-idle-ms を追加した layer-tap。
        // Pキー(SCROLL)はロールオーバーの多い「ぽ/ぴ」等の直後に叩かれるため、
        // &mt と同様に直前打鍵から150ms以内なら即タップに倒す。
        // 他の &lt 利用箇所(SPACEやENTER等)は単語直後にあえて長押しする
        // 使い方があるため、影響をPキーだけに限定する。

        lt_instant_tap: lt_instant_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "LT_INSTANT_TAP";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "balanced";
            quick-tap-ms = <300>;
            require-prior-idle-ms = <150>;
        };
    };

    zip_mouse_gesture_l7: zip_mouse_gesture_l7 {
        compatible = "zmk,input-processor-mouse-gesture";
        #input-processor-cells = <0>;
        always-active;
        enable-eager-mode;
        suppress-movement;
        stroke-size = <5>;
        movement-threshold = <6>;
        idle-timeout-ms = <100>;
        gesture-cooldown-ms = <120>;

        // Tab management

        prev_tab {
            pattern = <GESTURE_LEFT>;
            bindings = <&kp LC(LS(TAB))>;
        };

        next_tab {
            pattern = <GESTURE_RIGHT>;
            bindings = <&kp LC(TAB)>;
        };

        new_tab {
            pattern = <GESTURE_UP>;
            bindings = <&kp LG(T)>;
        };

        close_tab {
            pattern = <GESTURE_DOWN>;
            bindings = <&kp LG(W)>;
        };
    };

    zip_mouse_gesture_l8: zip_mouse_gesture_l8 {
        compatible = "zmk,input-processor-mouse-gesture";
        #input-processor-cells = <0>;
        always-active;
        enable-eager-mode;
        suppress-movement;
        stroke-size = <5>;
        movement-threshold = <6>;
        idle-timeout-ms = <100>;
        gesture-cooldown-ms = <120>;

        // Virtual desktop (Mission Control space) management
        // Left/right reversed to mimic trackpad-style natural swipe direction.

        desk_prev {
            pattern = <GESTURE_RIGHT>;
            bindings = <&kp LC(LEFT_ARROW)>;
        };

        desk_next {
            pattern = <GESTURE_LEFT>;
            bindings = <&kp LC(RIGHT_ARROW)>;
        };

        mission_ctrl {
            pattern = <GESTURE_UP>;
            bindings = <&kp LC(UP_ARROW)>;
        };

        app_expose {
            pattern = <GESTURE_DOWN>;
            bindings = <&kp LC(DOWN_ARROW)>;
        };
    };

    zip_mouse_gesture_l9: zip_mouse_gesture_l9 {
        compatible = "zmk,input-processor-mouse-gesture";
        #input-processor-cells = <0>;
        always-active;
        enable-eager-mode;
        suppress-movement;
        stroke-size = <5>;
        movement-threshold = <6>;
        idle-timeout-ms = <100>;
        gesture-cooldown-ms = <120>;

        // App switching / quick actions

        prev_app {
            pattern = <GESTURE_LEFT>;
            bindings = <&kp LG(LS(TAB))>;
        };

        next_app {
            pattern = <GESTURE_RIGHT>;
            bindings = <&kp LG(TAB)>;
        };

        focus_url {
            pattern = <GESTURE_UP>;
            bindings = <&kp LG(L)>;
        };

        spotlight {
            pattern = <GESTURE_DOWN>;
            bindings = <&kp LG(SPACE)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q                             &kp W                   &kp E       &kp R           &kp T                                                                          &kp Y             &kp U       &kp I       &kp O           &lt_instant_tap SCROLL P
&hm_instant LCTRL A               &mt LS(LEFT_COMMAND) S  &mt LGUI D  &mt LALT F      &mt LCTRL G    &kp TAB                         &mt RC(RS(RA(RGUI))) SEMICOLON  &kp H             &mt RALT J  &mt RGUI K  &mt RS(RGUI) L  &mt RCTRL MINUS
&mt LEFT_SHIFT Z                  &mt LEFT_SHIFT X        &kp C       &kp V           &kp B          &lt MOUSE LS(TAB)               &kp RS(RA(RC(RGUI)))            &kp N             &kp M       &kp COMMA   &kp DOT         &mt LEFT_SHIFT SLASH
&kp LGUI                          &kp LALT                &kp LGUI    &lt BT_L LANG2  &lt NUM SPACE  &lt_to_layer_0 ARROW LANG1      &kp BACKSPACE                   &lt SYMBOL ENTER                                          &lt MOUSE ESC
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        symbol_layer {
            bindings = <
&trans    &kp AMPERSAND  &kp ASTERISK  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS                         &kp CARET       &kp CARET        &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp AT_SIGN
&kp EXCL  &kp DQT        &kp HASH      &kp DLLR              &kp PRCNT              &trans      &kp COLON  &kp LEFT_BRACE  &kp RIGHT_BRACE  &kp LPAR          &kp RPAR           &kp TILDE
&kp F1    &kp F2         &kp F3        &kp F4                &kp F5                 &trans      &trans     &kp F6          &kp F7           &kp F8            &kp F9             &kp F10
&trans    &trans         &trans        &trans                &trans                 &trans      &trans     &trans                                                                &trans
            >;

            sensor-bindings = <&scroll_right_left>;
        };

        num_layer {
            bindings = <
&kp EQUAL           &kp SLASH     &kp STAR      &kp MINUS     &kp PLUS                                      &kp INT_YEN   &kp DOLLAR    &kp PIPE      &kp COLON     &kp PERCENT
&mt LCTRL NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp NUMBER_5  &trans               &mul_mark  &kp NUMBER_6  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &mt RCTRL NUMBER_0
&mt LSHFT NUMBER_6  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp NUMBER_0  &kp KP_MULTIPLY      &div_mark  &kp F11       &kp F12       &kp COMMA     &kp DOT       &mt RSHIFT DOLLAR
&trans              &trans        &trans        &trans        &trans        &trans               &trans     &trans                                                  &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        arrow_layer {
            // 右手側はWindows用ショートカット(Win+矢印スナップ, PrintScreen系)。Mac利用時は要調整。

            bindings = <
&kp PG_UP  &kp PG_UP       &kp UP_ARROW    &kp PAGE_DOWN    &kp PG_DN                                       &trans             &kp LC(LA(Y))           &kp LA(LC(UP_ARROW))    &kp LC(LA(U))            &trans
&kp HOME   &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp END    &trans      &kp LC(LG(PRINTSCREEN))  &trans             &kp LA(LC(LEFT_ARROW))  &kp LA(LC(DOWN_ARROW))  &kp LA(LC(RIGHT_ARROW))  &trans
&trans     &kp LGUI        &kp LS(TAB)     &kt TAB          &trans     &trans      &kp LS(PRINTSCREEN)      &trans             &kp LC(LA(H))           &kp RC(N)               &kp RA(RC(J))            &trans
&trans     &trans          &trans          &trans           &trans     &trans      &kp DELETE               &kp LA(LC(ENTER))                                                                           &trans
            >;

            sensor-bindings = <&inc_dec_kp LC(TAB) LC(LS(TAB))>;
        };

        bt_layer {
            bindings = <
&trans  &trans    &trans       &trans   &trans                           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &kp LGUI  &kp LS(TAB)  &kp TAB  &trans  &trans      &trans       &trans        &kp LS(TAB)   &trans        &kp TAB       &trans
&trans  &trans    &trans       &trans   &trans  &trans      &bootloader  &trans        &trans        &trans        &trans        &bt BT_CLR
&trans  &trans    &trans       &trans   &trans  &trans      &trans       &kp LGUI                                                &bt BT_CLR_ALL
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        mouse_layer {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans    &trans    &kp LG(C)  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &mkp MB1  &mkp MB3  &mkp MB2   &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &mkp MB4  &trans    &mkp MB5   &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                 &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        scroll_layer {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        Gesture_L7 {
            // Trackball gestures only; keys stay inert. See zip_mouse_gesture_l7.

            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        Gesture_L8 {
            // Trackball gestures only; keys stay inert. See zip_mouse_gesture_l8.

            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        Gesture_L9 {
            // Trackball gestures only; keys stay inert. See zip_mouse_gesture_l9.

            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };
    };
};
